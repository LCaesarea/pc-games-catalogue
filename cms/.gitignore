############################
# Assignment 2
############################

# The content export must be committed, even though *.gz is ignored above.
!seed/a2-content.tar.gz

# docker-compose.yml reads this file (env_file: ./cms/.env), so a clone without
# it cannot start Strapi. It holds local development values only. This line has
# to live here: a rule in this file beats the !cms/.env line in the root
# .gitignore, because the deeper file wins.
!.env
