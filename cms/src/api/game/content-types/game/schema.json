{
  "kind": "collectionType",
  "collectionName": "games",
  "info": {
    "singularName": "game",
    "pluralName": "games",
    "displayName": "Game",
    "description": "A PC game in the catalogue"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": { "type": "string", "required": true, "unique": true },
    "title": { "type": "string", "required": true },
    "year": { "type": "integer", "required": true },
    "genres": { "type": "string", "required": true },
    "coop": { "type": "boolean", "required": true, "default": false },
    "rating": { "type": "decimal", "required": true },
    "description": { "type": "text", "required": true },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
